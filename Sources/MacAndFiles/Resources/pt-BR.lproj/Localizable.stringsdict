			<key>other</key>
			<string>Busca: %ld dispositivos</string>
		</dict>
	</dict>
	<key>items.ready</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld item · Pronto</string>
			<key>other</key>
			<string>%ld itens · Pronto</string>
		</dict>
	</dict>
	<key>upload.started</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
